<svg xmlns="http://www.w3.org/2000/svg" width="300" height="480" viewBox="0 0 300 480">
  <rect width="300" height="480" fill="#ffe6f3" rx="20"/>
  <!-- Body silhouette -->
  <!-- Head -->
  <ellipse cx="150" cy="70" rx="45" ry="50" fill="#f5d5b8"/>
  <!-- Hair -->
  <ellipse cx="150" cy="55" rx="50" ry="40" fill="#FFD700"/>
  <rect x="100" y="55" width="20" height="80" fill="#FFD700" rx="10"/>
  <rect x="180" y="55" width="20" height="80" fill="#FFD700" rx="10"/>
  <!-- Eyes -->
  <ellipse cx="135" cy="70" rx="8" ry="9" fill="#fff"/>
  <ellipse cx="165" cy="70" rx="8" ry="9" fill="#fff"/>
  <ellipse cx="135" cy="71" rx="5" ry="6" fill="#5533AA"/>
  <ellipse cx="165" cy="71" rx="5" ry="6" fill="#5533AA"/>
  <ellipse cx="133" cy="69" rx="2" ry="2" fill="#fff"/>
  <ellipse cx="163" cy="69" rx="2" ry="2" fill="#fff"/>
  <!-- Nose -->
  <ellipse cx="150" cy="82" rx="4" ry="3" fill="#e8b89a"/>
  <!-- Mouth -->
  <path d="M138 92 Q150 100 162 92" stroke="#d47c8a" stroke-width="2" fill="none" stroke-linecap="round"/>
  <!-- Neck -->
  <rect x="140" y="115" width="20" height="25" fill="#f5d5b8" rx="5"/>
  <!-- Body/top -->
  <rect x="105" y="138" width="90" height="100" fill="#ffffff" rx="15" opacity="0.9"/>
  <!-- Arms -->
  <rect x="65" y="138" width="42" height="18" fill="#f5d5b8" rx="9"/>
  <rect x="55" y="152" width="18" height="70" fill="#f5d5b8" rx="9"/>
  <rect x="193" y="138" width="42" height="18" fill="#f5d5b8" rx="9"/>
  <rect x="227" y="152" width="18" height="70" fill="#f5d5b8" rx="9"/>
  <!-- Hands -->
  <ellipse cx="64" cy="228" rx="13" ry="11" fill="#f5d5b8"/>
  <ellipse cx="236" cy="228" rx="13" ry="11" fill="#f5d5b8"/>
  <!-- Bottom/shorts -->
  <rect x="105" y="235" width="90" height="70" fill="#ffffff" rx="10" opacity="0.85"/>
  <!-- Legs -->
  <rect x="112" y="302" width="30" height="110" fill="#f5d5b8" rx="12"/>
  <rect x="158" y="302" width="30" height="110" fill="#f5d5b8" rx="12"/>
  <!-- Shoes -->
  <ellipse cx="127" cy="415" rx="25" ry="12" fill="#FF2D9B" rx="10"/>
  <ellipse cx="173" cy="415" rx="25" ry="12" fill="#FF2D9B" rx="10"/>
  <!-- Cheeks -->
  <ellipse cx="120" cy="88" rx="12" ry="8" fill="#ff8fb5" opacity="0.4"/>
  <ellipse cx="180" cy="88" rx="12" ry="8" fill="#ff8fb5" opacity="0.4"/>
  <!-- Label -->
  <text x="150" y="455" text-anchor="middle" font-family="Arial" font-size="14" fill="#FF2D9B" font-weight="bold">BASE MODEL ✨</text>
</svg>
